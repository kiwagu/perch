{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Perch data model",
  "description": "The entities the screens read and write; the platform's own tables (accounts, organisations, memberships, device sessions) are reached through the actions of platform.yaml.",
  "$defs": {
    "profile": {
      "type": "object",
      "description": "The public face of an account: its name, contact email and bio. It lives in the account's private region, so the account reads and edits it offline on each of its devices.",
      "x-perch": {
        "table": "profile",
        "region": "private",
        "id": "prf",
        "actions": {
          "createProfile": {
            "description": "Creates the profile of a new account on the first device that enters it.",
            "params": { "id": "$id", "identity": "identity", "name": "name", "email": "email" },
            "changes": ["accounts.read"]
          },
          "updateName": {
            "description": "Replaces the name.",
            "params": { "id": "$id", "name": "name" },
            "changes": ["accounts.list", "accounts.read"]
          },
          "updateBio": {
            "description": "Replaces the bio.",
            "params": { "id": "$id", "bio": "bio" },
            "changes": []
          }
        },
        "unique": [["identity"]]
      },
      "properties": {
        "id": {
          "type": "string",
          "description": "The profile's id, prefix prf.",
          "x-perch": { "readonly": true }
        },
        "identity": {
          "type": "string",
          "description": "The account the profile belongs to; one profile per account.",
          "x-perch": { "record": "identity", "readonly": true }
        },
        "name": {
          "type": "string",
          "description": "The name the account shows.",
          "minLength": 1,
          "maxLength": 80,
          "x-perch": { "crdt": "none" }
        },
        "email": {
          "type": "string",
          "description": "The account's email, in lower case as the account keeps it.",
          "format": "email",
          "x-perch": { "readonly": true }
        },
        "bio": {
          "type": "string",
          "description": "A free text about the account.",
          "maxLength": 2000,
          "x-perch": { "crdt": "text" }
        },
        "created_at": {
          "type": "string",
          "description": "When the profile was created.",
          "format": "date-time",
          "x-perch": { "readonly": true }
        }
      },
      "required": ["id", "identity", "name", "email", "created_at"],
      "additionalProperties": false
    },
    "settings": {
      "type": "object",
      "description": "The settings of an account: what the app is like for it. Each of its devices reads and changes them offline, and nobody but the account ever reads them.",
      "x-perch": {
        "table": "settings",
        "region": "private",
        "id": "stg",
        "actions": {
          "createSettings": {
            "description": "Creates the settings of a new account on the first device that enters it, as its profile, each with its starting value: the language the account signed up with, and the theme that device shows.",
            "params": { "id": "$id", "identity": "identity", "locale": "locale", "theme": "theme" },
            "changes": []
          },
          "updateLocale": {
            "description": "Stores the language the account chose.",
            "params": { "id": "$id", "locale": "locale" },
            "changes": []
          },
          "updateTheme": {
            "description": "Stores the theme the account chose.",
            "params": { "id": "$id", "theme": "theme" },
            "changes": []
          }
        },
        "unique": [["identity"]]
      },
      "properties": {
        "id": {
          "type": "string",
          "description": "The settings' id, prefix stg.",
          "x-perch": { "readonly": true }
        },
        "identity": {
          "type": "string",
          "description": "The account the settings belong to; one row per account.",
          "x-perch": { "record": "identity", "readonly": true }
        },
        "locale": {
          "description": "The language the account chose; it follows the account across devices.",
          "enum": ["en", "es"],
          "x-perch": { "crdt": "none" }
        },
        "theme": {
          "description": "The theme the account chose: light, dark, or system (the device's own setting, followed as it changes); it follows the account across its tabs and devices.",
          "enum": ["light", "dark", "system"],
          "x-perch": { "crdt": "none" }
        }
      },
      "required": ["id", "identity", "locale", "theme"],
      "additionalProperties": false
    },
    "note": {
      "type": "object",
      "description": "A note shared by every member of the organisation.",
      "x-perch": {
        "table": "note",
        "region": "tenant",
        "id": "nte",
        "owner": "author",
        "can": {
          "member": { "create": "any", "update": "own", "delete": "own" },
          "admin": { "create": "any", "update": "any", "delete": "any" }
        },
        "actions": {
          "createNote": {
            "description": "Adds a note by the signed-in member.",
            "params": { "id": "$id", "author": "author", "text": "text" },
            "changes": []
          },
          "updateNote": {
            "description": "Replaces the text of a note.",
            "params": { "id": "$id", "text": "text" },
            "changes": []
          },
          "deleteNote": {
            "description": "Deletes a note.",
            "params": { "id": "$id" },
            "changes": []
          }
        }
      },
      "properties": {
        "id": {
          "type": "string",
          "description": "The note's id, prefix nte.",
          "x-perch": { "readonly": true }
        },
        "author": {
          "type": "string",
          "description": "The member who wrote it.",
          "x-perch": { "record": "member", "readonly": true }
        },
        "text": {
          "type": "string",
          "description": "The text of the note.",
          "minLength": 1,
          "maxLength": 500,
          "x-perch": { "crdt": "text" }
        },
        "created_at": {
          "type": "string",
          "description": "When the note was written; the notes are listed oldest first.",
          "format": "date-time",
          "x-perch": { "readonly": true }
        }
      },
      "required": ["id", "author", "text", "created_at"],
      "additionalProperties": false
    }
  }
}
