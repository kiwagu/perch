{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "description": "The JSON Schema of the file: `./manifest.schema.json`.",
      "type": "string"
    },
    "manifestVersion": {
      "type": "number",
      "const": 1,
      "description": "The version of the manifest format."
    },
    "product": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "The product name."
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "description": "The version of the root package.json."
        },
        "commit": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            {
              "type": "null"
            }
          ],
          "description": "The commit the manifest was built from, or null outside git."
        }
      },
      "required": [
        "name",
        "version",
        "commit"
      ],
      "additionalProperties": false,
      "description": "The product the manifest describes."
    }
  },
  "required": [
    "manifestVersion",
    "product"
  ],
  "additionalProperties": false,
  "description": "The UI manifest: the contract of the application for tests and agents."
}
