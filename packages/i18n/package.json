{
  "name": "@workspace/i18n",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "i18n-check": "./src/cli.ts"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./check": {
      "types": "./src/check.ts",
      "import": "./src/check.ts"
    },
    "./translator": {
      "types": "./src/translator.ts",
      "import": "./src/translator.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "oxc-parser": "catalog:"
  },
  "peerDependencies": {
    "react": "catalog:"
  },
  "devDependencies": {
    "@testing-library/react": "catalog:",
    "@types/bun": "catalog:",
    "@types/react": "catalog:",
    "jsdom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
