{
  "name": "@workspace/kernel",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "emit": "ui-contract emit values --out src/contract-values.gen.ts && ui-contract emit terms --out src/contract-terms.gen.ts"
  },
  "dependencies": {
    "@workspace/zod": "workspace:*",
    "neverthrow": "catalog:",
    "remeda": "catalog:",
    "ts-pattern": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "@workspace/ui-contract": "workspace:*",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
