{
  "$schema": "./screens.schema.json",
  "version": 1,
  "screens": [
    {
      "id": "sample",
      "title": "One thing, edited",
      "bindings": [{ "path": "/sample", "guard": "authenticated", "roles": ["member"] }],
      "flag": null,
      "entry": ["sample.page", "sample.title-input"],
      "anchors": {
        "sample.page": { "kind": "page", "description": "The root of the screen." },
        "sample.title-input": {
          "kind": "input",
          "binding": { "model": "thing.title" }
        },
        "sample.save-button": {
          "kind": "button",
          "binding": [
            { "action": "thing.createThing", "params": { "title": "sample.title-input" } },
            { "action": "thing.updateThing", "params": { "title": "sample.title-input" } }
          ],
          "roles": ["member"],
          "codes": ["saved", "failed"]
        },
        "sample.list": {
          "kind": "list",
          "source": { "entity": "thing", "order": "created_at", "direction": "asc" },
          "states": ["loading"]
        },
        "sample.list.item": { "kind": "item", "dataId": "the thing's id" },
        "sample.sign-out-button": {
          "kind": "button",
          "binding": {
            "action": "platform.sign-out",
            "params": { "forgetUnsent": { "value": true } }
          }
        }
      },
      "flow": {
        "states": ["editing", "saving"],
        "initial": "editing",
        "events": [
          {
            "on": "sample.save-button",
            "action": "thing.updateThing",
            "from": "editing",
            "params": { "title": "sample.title-input" },
            "outcomes": { "success": { "codes": ["saved"] }, "failure": { "codes": ["failed"] } }
          }
        ]
      }
    }
  ],
  "platform": {
    "actions": {
      "sign-out": {
        "description": "Signs this device out.",
        "params": {
          "forgetUnsent": { "type": "boolean", "description": "Drop the unsent changes." }
        },
        "result": "this device signs out",
        "codes": ["failed"]
      }
    },
    "reserved": ["sample.status"],
    "status": { "anchor": "sample.status", "states": ["ready"] }
  },
  "scenarios": [
    {
      "id": "sample/01-edit",
      "title": "Edit the thing",
      "tags": ["smoke"],
      "devices": { "A": "member" },
      "where": "[/sample]",
      "data": { "Title": "generate" },
      "scenario": "A member renames the thing",
      "steps": ["Open [/sample]", "Enter the title into [sample.title-input]"],
      "expected": ["[sample.save-button] saves with [code:saved]"]
    }
  ]
}
