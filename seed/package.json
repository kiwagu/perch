{
  "name": "@workspace/seed",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./catalog": {
      "types": "./src/catalog.ts",
      "import": "./src/catalog.ts"
    }
  },
  "bin": {
    "seed": "./src/cli.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:db": "vitest run --config vitest.db.config.ts"
  },
  "dependencies": {
    "@workspace/data": "workspace:*",
    "@workspace/kernel": "workspace:*",
    "@workspace/web": "workspace:*",
    "@workspace/zod": "workspace:*",
    "neverthrow": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
