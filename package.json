{
  "name": "perch",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.3",
  "scripts": {
    "prepare": "lefthook install",
    "build": "bun run scripts/build-capped.ts",
    "dev": "bun run scripts/turbo-with-exclude.ts dev",
    "typecheck": "turbo run typecheck typecheck:root",
    "lint": "turbo run lint lint:root",
    "test": "turbo run test",
    "model": "turbo run model",
    "model:check": "turbo run model:check",
    "i18n:check": "turbo run i18n:check",
    "test:db": "turbo run test:db",
    "test:e2e": "turbo run test:e2e",
    "refactor:scan": "bun run scripts/find-refactor-candidates.ts",
    "check": "turbo run typecheck typecheck:root lint lint:root test model:check i18n:check refactor:ci",
    "typecheck:root": "tsc -p scripts/tsconfig.json",
    "lint:root": "biome ci . && eslint scripts",
    "refactor:ci": "bun run scripts/find-refactor-candidates.ts --ci"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@types/bun": "catalog:",
    "@workspace/eslint-config": "workspace:*",
    "eslint": "catalog:",
    "lefthook": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:"
  },
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*",
      "tests/*"
    ],
    "catalog": {
      "@base-ui/react": "1.9.0",
      "@biomejs/biome": "2.5.15",
      "@fontsource-variable/inter": "5.3.0",
      "@playwright/test": "1.64.1",
      "@stylistic/eslint-plugin": "5.10.0",
      "@surrealdb/node": "3.1.0",
      "@surrealdb/node-native": "3.3.4",
      "@surrealdb/surql-fmt": "0.1.0-beta.3",
      "@surrealdb/wasm": "3.1.0",
      "@surrealdb/wasm-native": "3.3.4",
      "@tailwindcss/vite": "4.3.3",
      "@tanstack/react-router": "1.170.44",
      "@testing-library/jest-dom": "7.0.1",
      "@testing-library/react": "16.3.3",
      "@testing-library/user-event": "14.6.8",
      "@types/bun": "1.4.3",
      "@types/node": "26.6.5",
      "@types/react": "19.3.0",
      "@types/react-dom": "19.3.0",
      "@vitejs/plugin-react": "6.1.2",
      "@vitest/coverage-v8": "5.0.5",
      "@xstate/react": "6.1.0",
      "class-variance-authority": "0.7.1",
      "cn": "0.5.0",
      "entity-id": "1.2.0",
      "eslint": "10.12.0",
      "eslint-plugin-boundaries": "7.2.0",
      "eslint-plugin-functional": "10.0.1",
      "eslint-plugin-react": "7.37.5",
      "jsdom": "30.1.3",
      "lefthook": "2.2.2",
      "loro-crdt": "1.16.4",
      "lucide-react": "1.58.0",
      "neverthrow": "8.2.0",
      "oxc-parser": "0.154.0",
      "pino": "10.4.0",
      "react": "19.3.1",
      "react-dom": "19.3.1",
      "remeda": "2.52.0",
      "shadcn": "4.22.0",
      "smol-toml": "1.9.1",
      "surrealdb": "2.1.1",
      "tailwindcss": "4.3.3",
      "ts-pattern": "5.9.2",
      "turbo": "2.11.8",
      "tw-animate-css": "1.4.0",
      "typescript": "7.0.2",
      "typescript-eslint": "8.71.2",
      "vite": "8.3.4",
      "vite-tsconfig-paths": "6.1.1",
      "vitest": "5.0.5",
      "xstate": "5.33.2",
      "zod": "4.6.7"
    },
    "catalogs": {
      "lint": {
        "typescript": "6.0.3"
      }
    }
  }
}
