{
	admin off
	auto_https off
}

# The browser security headers, on every response of the site, so a page and a worker both get
# them with their own script: the e2e fixtures hold every document and script to these values and
# fail a test on any policy violation a page or a worker reports.
(security-headers) {
	header {
		# The app loads only what this origin serves: its scripts (no inline one), its styles and
		# fonts, its web app manifest (which makes it installable), the engine's module worker,
		# fetches and the WebSocket to /backend. The two WASM engines compile their modules, which
		# 'wasm-unsafe-eval' allows without allowing eval.
		# No other site may frame the app, no <base> may move its links, forms post only here.
		Content-Security-Policy "default-src 'none'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self'; connect-src 'self'; style-src 'self'; font-src 'self'; img-src 'self'; manifest-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'"
		# The same ban on framing for browsers that predate frame-ancestors.
		X-Frame-Options "DENY"
		# A full referrer stays on this origin; another origin learns nothing of the page.
		Referrer-Policy "same-origin"
		# The app uses none of these, so nothing it loads may ask for them.
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), browsing-topics=()"
		# Every file is served with its own type; the browser never guesses another.
		X-Content-Type-Options "nosniff"
		# No Strict-Transport-Security here: it binds the whole host, so sent from
		# https://localhost it would force https on every local port of the machine. A deployed
		# front sends it for its own domain.
	}
}

# Whom the front names to the gateway as the client: the gateway counts its request limits by
# the rightmost X-Forwarded-For entry. `peer`, the default, is the address the request came
# from, which reverse_proxy writes there itself. The e2e stand runs with `claimed`: every browser
# of its suite reaches the front from 127.0.0.1, so each Playwright worker claims an address of its
# own in X-Perch-Client-Address, and spends its own limits as a client of its own would; a request
# without the header leaves the entry empty, and the gateway takes the connection's address.
(client-address-peer) {
}

(client-address-claimed) {
	header_up X-Forwarded-For {header.X-Perch-Client-Address}
	header_up -X-Perch-Client-Address
}

# One site per stand: the mcproc apps caddy-dev and caddy-e2e run this file with the ports of
# this checkout's stand in the container's environment (FRONT_PORT, GATEWAY_PORT),
# PERCH_UI_MANIFEST (1, the default, serves /ui-manifest/; 0 answers 404 there) and
# PERCH_CLIENT_ADDRESS (peer, the default, or claimed: the snippets above).
https://localhost:{$FRONT_PORT} {
	bind 127.0.0.1
	tls /certs/localhost.pem /certs/localhost-key.pem
	root * /srv/web
	encode zstd gzip
	import security-headers

	@shell path / /index.html

	# The UI manifest the build ships, for tests and agents; PERCH_UI_MANIFEST=0 switches it off.
	@manifestOff expression `"{$PERCH_UI_MANIFEST:1}" == "0"`
	handle /ui-manifest/* {
		header Cache-Control "no-store"
		respond @manifestOff 404
		file_server
	}
	handle_path /backend/* {
		reverse_proxy 127.0.0.1:{$GATEWAY_PORT} {
			import client-address-{$PERCH_CLIENT_ADDRESS:peer}
		}
	}
	# The web app's build, a single-page app: any path that is not a file gets index.html.
	# The route keeps the written order, so the headers see the path after try_files and a
	# deep link served as index.html is revalidated like index.html itself.
	handle {
		route {
			try_files {path} /index.html
			header /assets/* Cache-Control "public, max-age=31536000, immutable"
			header @shell Cache-Control "no-cache"
			file_server
		}
	}
}
