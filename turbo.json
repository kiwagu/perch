{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["database/schema/**", "contract/**", "tests/e2e/scenarios/**"],
  "globalPassThroughEnv": [
    "CI",
    "SURREAL_URL",
    "SURREAL_NS",
    "SURREAL_DB",
    "SURREAL_USER",
    "SURREAL_PASS",
    "GATEWAY_PORT",
    "GATEWAY_SURREAL_USER",
    "GATEWAY_SURREAL_PASS",
    "GATEWAY_AUTH_SECRET",
    "GATEWAY_PUBLIC_URL",
    "GATEWAY_SMTP_URL",
    "GATEWAY_MAIL_FROM",
    "MAILBOX_URL",
    "MAILBOX_DEV_URL",
    "GATEWAY_URL",
    "LOG_LEVEL",
    "LOG_FORMAT",
    "VITEST_MAX_WORKERS"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "env": ["PERCH_UI_HOOKS"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "lint": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/eslint.config.js",
        "$TURBO_ROOT$/packages/eslint-config/src/**",
        "$TURBO_ROOT$/packages/kernel/src/contract-terms.gen.ts"
      ]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "@workspace/web#test": {
      "dependsOn": ["^build"],
      "env": ["CONTRACT_AHEAD", "CONTRACT_AHEAD_BASE", "CONTRACT_AHEAD_HEAD"]
    },
    "@workspace/kernel#test": {
      "dependsOn": ["^build"],
      "env": ["CONTRACT_AHEAD", "CONTRACT_AHEAD_BASE", "CONTRACT_AHEAD_HEAD"]
    },
    "@workspace/gateway#test": {
      "dependsOn": ["^build"],
      "env": ["CONTRACT_AHEAD", "CONTRACT_AHEAD_BASE", "CONTRACT_AHEAD_HEAD"]
    },
    "@workspace/database#test": {
      "dependsOn": ["^build"],
      "env": ["CONTRACT_AHEAD", "CONTRACT_AHEAD_BASE", "CONTRACT_AHEAD_HEAD"]
    },
    "model": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "emit": {
      "cache": false
    },
    "model:check": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "i18n:check": {
      "cache": false
    },
    "test:db": {
      "cache": false
    },
    "test:e2e": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "//#typecheck:root": {
      "cache": false
    },
    "//#test:root": {
      "cache": false
    },
    "//#lint:root": {
      "cache": false
    },
    "//#refactor:ci": {
      "cache": false
    },
    "//#readme:check": {
      "cache": false
    },
    "//#lint:surql": {
      "cache": false
    },
    "//#e2e:coverage": {
      "cache": false
    },
    "//#contract:coverage:check": {
      "cache": false
    },
    "//#contract:check": {
      "cache": false
    },
    "//#contract:check:current": {
      "cache": false
    },
    "//#contract:check:sources": {
      "cache": false
    },
    "//#contract:check:consumers": {
      "inputs": ["tests/e2e/src/**", "contract/**", "tests/e2e/scenarios/**"],
      "cache": false
    }
  }
}
