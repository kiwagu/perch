{
  "name": "@workspace/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./replica-schema": {
      "types": "./src/replica.schema.gen.ts",
      "import": "./src/replica.schema.gen.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test:db": "surrealkit --folder . --host \"${SURREAL_URL:-http://127.0.0.1:8010}\" --user root --pass root test --no-seed && vitest run"
  },
  "dependencies": {
    "@workspace/replica": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "@workspace/data": "workspace:*",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
